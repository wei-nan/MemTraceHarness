{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "run_planner",
        "run_operational_action",
        "ask_human",
        "stop",
        "no_action_needed",
        "finish",
        "merge",
        "next_phase",
        "revise_phases"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    },
    "searched_history": {
      "type": "boolean",
      "description": "True if you called a MemTrace search/lookup tool during this decision, false if you decided it wasn't needed. Must be honest either way — say so in `reason` too."
    },
    "decision_card": {
      "type": [
        "object",
        "null"
      ],
      "description": "How to ask the human to decide; null when not stopping for a human.",
      "properties": {
        "situation": {
          "type": "string",
          "maxLength": 600
        },
        "options": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "action": {
                "type": "string",
                "maxLength": 400
              },
              "tradeoff": {
                "type": "string",
                "maxLength": 300
              }
            },
            "required": [
              "label",
              "action",
              "tradeoff"
            ],
            "additionalProperties": false
          }
        },
        "recommended": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "reason": {
          "type": "string",
          "maxLength": 300
        },
        "default_if_silent": {
          "type": "string",
          "maxLength": 200
        },
        "basis": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 20
          }
        }
      },
      "required": [
        "situation",
        "options",
        "recommended",
        "reason",
        "default_if_silent",
        "basis"
      ],
      "additionalProperties": false
    },
    "kb_updates": {
      "type": [
        "array",
        "null"
      ],
      "description": "Updates to the knowledge base the harness should apply; null when none.",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "claim_done",
              "note"
            ]
          },
          "node_id": {
            "type": "string",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "body": {
            "type": "string",
            "maxLength": 4000
          },
          "content_type": {
            "type": "string",
            "enum": [
              "factual",
              "procedural",
              "context",
              "inquiry",
              "preference"
            ]
          },
          "links": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "properties": {
                "to_id": {
                  "type": "string",
                  "maxLength": 64
                },
                "relation": {
                  "type": "string",
                  "enum": [
                    "related_to",
                    "extends",
                    "extracted_from",
                    "depends_on",
                    "contradicts",
                    "superseded_by",
                    "answered_by"
                  ]
                }
              },
              "required": [
                "to_id",
                "relation"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "op",
          "node_id",
          "title",
          "body",
          "content_type",
          "links"
        ],
        "additionalProperties": false
      }
    },
    "goal_plan": {
      "type": [
        "object",
        "null"
      ],
      "description": "At the start stage with action run_planner: the plan for the user's WHOLE original request. Null at every other stage.",
      "properties": {
        "restated_goal": {
          "type": "string",
          "maxLength": 600
        },
        "success_criteria": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 600
          }
        },
        "phases": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 120
              },
              "purpose": {
                "type": "string",
                "maxLength": 600
              },
              "skills": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "enum": [
                    "plan",
                    "develop"
                  ]
                }
              },
              "acceptance": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "maxLength": 600
                }
              }
            },
            "required": [
              "title",
              "purpose",
              "skills",
              "acceptance"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "restated_goal",
        "success_criteria",
        "phases"
      ],
      "additionalProperties": false
    },
    "goal_check": {
      "type": [
        "object",
        "null"
      ],
      "description": "After a phase finished: whether each success criterion of the user's original request is met, with evidence. Null at the start stage.",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "met",
            "partly_met",
            "not_met"
          ]
        },
        "criteria": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string",
                "maxLength": 600
              },
              "status": {
                "type": "string",
                "enum": [
                  "met",
                  "unmet",
                  "unverified"
                ]
              },
              "evidence": {
                "type": "string",
                "maxLength": 400
              }
            },
            "required": [
              "criterion",
              "status",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "remaining": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      },
      "required": [
        "verdict",
        "criteria",
        "remaining"
      ],
      "additionalProperties": false
    },
    "phases": {
      "type": [
        "array",
        "null"
      ],
      "description": "With action revise_phases: the phases still to do, replacing any not yet run. Null otherwise.",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "purpose": {
            "type": "string",
            "maxLength": 600
          },
          "skills": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string",
              "enum": [
                "plan",
                "develop"
              ]
            }
          },
          "acceptance": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "maxLength": 600
            }
          }
        },
        "required": [
          "title",
          "purpose",
          "skills",
          "acceptance"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "action",
    "reason",
    "searched_history",
    "decision_card",
    "kb_updates",
    "goal_plan",
    "goal_check",
    "phases"
  ],
  "additionalProperties": false
}
