# Env file of one Telegram service: one bot in front of one Harness.
# Keep it OUTSIDE the Harness's workspace (the models work in that folder), mode 0600, e.g.
#   ~/.config/memtraceharness/<project>/telegram.env
# Run:  python -m memtrace_services.telegram.main --env-file <this file>

TELEGRAM_BOT_TOKEN=            # from @BotFather
# Hard allowlist, enforced before anything is relayed: any other chat is silently dropped.
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# The Harness this bot serves (its HARNESS_API_PORT / HARNESS_API_TOKEN)
HARNESS_URL=http://127.0.0.1:8800
HARNESS_API_TOKEN=

# TELEGRAM_POLL_TIMEOUT=30
# TELEGRAM_STATE_FILE=            # default: next to this file (the update offset)

# Optional: a local door for scripts that want to say something through this bot without ever
# holding its token (POST /v1/send {"text": ...}, POST /v1/send_photo {"path": ...}).
# TELEGRAM_RELAY_PORT=8900
# TELEGRAM_RELAY_TOKEN=
# TELEGRAM_RELAY_PHOTO_ROOTS=/Users/me/Workspace/project/charts   # photos are read only from here
