# .harness.env — one Harness's settings and secrets. Lives in the workspace folder (mode 0600,
# kept out of git by `init-workspace`). Created for you by `memtrace-harness init-workspace`.
# Nothing about Telegram or the status page belongs here: those are services with their own files
# (examples/telegram.env, examples/web.toml).

# --- the knowledge base
MEMTRACE_MCP_URL=http://localhost:8000/api/v1/mcp/mcp
MEMTRACE_API_TOKEN=

# --- this Harness's local API: the one door services use. The token is shared with them.
HARNESS_API_HOST=127.0.0.1
HARNESS_API_PORT=8800
HARNESS_API_TOKEN=

# --- model CLIs (names or absolute paths)
HARNESS_CLAUDE_COMMAND=claude
HARNESS_CODEX_COMMAND=codex
HARNESS_ANTIGRAVITY_COMMAND=agy
HARNESS_ANTIGRAVITY_OUTPUT_MODE=auto
HARNESS_CLI_TIMEOUT_SECONDS=900

# --- models. One workspace is one project, so these have no per-project suffix.
HARNESS_CHAT_PROVIDER=claude
HARNESS_CHAT_MODEL=haiku
# HARNESS_CHAT_FALLBACKS=antigravity/gemini-3.6-flash-high
# Nightly memory digest model, independent of chat (use a stronger one). Optional;
# unset = reuse the chat model.
# HARNESS_DIGEST_PROVIDER=claude
# HARNESS_DIGEST_MODEL=sonnet
# HARNESS_DIGEST_FALLBACKS=codex/gpt-6
# Background topic recall (finds earlier discussion of the current topic; see
# docs/operating-contract.md). Optional; unset = reuse the digest model.
# HARNESS_RECALL_ENABLED=false turns it off.
# HARNESS_RECALL_PROVIDER=claude
# HARNESS_RECALL_MODEL=claude-sonnet-5-5
# HARNESS_RECALL_FALLBACKS=codex/gpt-6
# HARNESS_RECALL_TTL_HOURS=72
# Role profiles (Controller/Planner/Red Team/Developer): this workspace's own file. Unset = the
# packaged default. `.harness/roles.toml` is picked up automatically when it exists.
# HARNESS_ROLE_PROFILES_FILE=.harness/roles.toml

# --- memory
# Where conversation memory is written; unset = the project's own MemTrace workspace.
# HARNESS_MEMORY_WORKSPACE_ID=ws_...
# HARNESS_OPERATOR_PREFERENCE_WORKSPACE_ID=ws_...

# --- behaviour
HARNESS_UNATTENDED_WRITE_REQUIRES_APPROVAL=true
# Timezone used to resolve "daily"/"weekdays" schedule time-of-day directives
# (e.g. HARNESS_SCHEDULE_START::daily::09:00::...). Any IANA zoneinfo name.
HARNESS_SCHEDULE_TIMEZONE=Asia/Taipei
# Names of extra environment variables a model's child process may inherit. By default it gets
# only PATH/HOME/locale/proxy/CLI-login variables — never the secrets in this file.
# HARNESS_PASSTHROUGH_ENV=

# --- state (defaults live in .harness/ next to this file; override only to move them)
# HARNESS_TRACE_DB=
# HARNESS_TRACE_ROOT=
