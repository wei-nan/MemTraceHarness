MEMTRACE_MCP_URL=http://localhost:8000/api/v1/mcp/mcp
MEMTRACE_API_TOKEN=
HARNESS_TRACE_DB=data/harness.sqlite3
HARNESS_TRACE_ROOT=data/traces
HARNESS_CLAUDE_COMMAND=claude
HARNESS_CODEX_COMMAND=codex
HARNESS_ANTIGRAVITY_COMMAND=agy
HARNESS_ANTIGRAVITY_OUTPUT_MODE=auto
HARNESS_CLI_TIMEOUT_SECONDS=900
HARNESS_TELEGRAM_BOT_TOKEN=
HARNESS_TELEGRAM_ALLOWED_CHAT_IDS=
HARNESS_PROJECT_INDEX=projects.index.txt
HARNESS_CHAT_PROVIDER=claude
HARNESS_CHAT_MODEL=haiku
HARNESS_UNATTENDED_WRITE_REQUIRES_APPROVAL=true
# Seconds between unattended backlog scan passes (per project) in `gateway --serve`.
# Each pass costs a search_nodes call even with an empty backlog — keep well above
# a few minutes. Default 1800 (was 60, see ws_spec_plan/mem_c9c4affd).
SCAN_INTERVAL_SECONDS=1800
# Timezone used to resolve "daily"/"weekdays" schedule time-of-day directives
# (e.g. HARNESS_SCHEDULE_START::daily::09:00::...). Any IANA zoneinfo name.
HARNESS_SCHEDULE_TIMEZONE=Asia/Taipei
